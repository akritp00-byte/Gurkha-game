# Local overrides: copy this file to .env (cp .env.example .env).
# .env is git-ignored. Never commit real secrets.

# --- Game server ---
# Port for HTTP and WebSocket traffic.
PORT=2567

# --- Client (Vite) ---
# Only variables starting with VITE_ reach the browser, so never put secrets in them.
# Game server base URL. Leave empty in development to use the page's host on port 2567.
# Set it if you change PORT or host the server elsewhere, e.g. https://eu.example.com
VITE_SERVER_URL=
